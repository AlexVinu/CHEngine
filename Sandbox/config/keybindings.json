{
  "Editor.Gizmo.Translate":     [{ "key": "T", "trigger": "Pressed" }],
  "Editor.Gizmo.Rotate":        [{ "key": "R", "trigger": "Pressed" }],
  "Editor.Gizmo.Scale":         [{ "key": "S", "trigger": "Pressed" }],

  "Editor.Entity.Delete":       [{ "key": "Delete",    "trigger": "Pressed" },
                                 { "key": "Backspace", "trigger": "Pressed" }],

  "Editor.History.Undo":        [{ "key": "Z", "mods": ["Ctrl"], "trigger": "Pressed" }],

  "Editor.Play.Toggle":         [{ "key": "P",      "mods": ["Ctrl"], "trigger": "Pressed" }],
  "Editor.Play.Stop":           [{ "key": "Escape", "trigger": "Pressed" }],

  "Editor.Profiler.Toggle":     [{ "key": "F3", "trigger": "Pressed" }],

  "Editor.Camera.Focus":        [{ "key": "F", "trigger": "Pressed" }],

  "Editor.Menu.AddEntity":      [{ "key": "A", "mods": ["Shift"], "trigger": "Pressed" }],
  "Editor.Menu.AddWindow":      [{ "key": "W", "mods": ["Shift"], "trigger": "Pressed" }],

  "Editor.Script.Save":         [{ "key": "S", "mods": ["Ctrl"], "trigger": "Pressed" }],

  "Editor.Popup.Close":         [{ "key": "Escape", "trigger": "Pressed" }],

  "Editor.Camera.OrbitRmb":     [{ "mouse": "Right",  "trigger": "Drag", "drag_threshold": 1.0 }],
  "Editor.Camera.OrbitAltLmb":  [{ "mouse": "Left",   "mods": ["Alt"],            "trigger": "Drag", "drag_threshold": 1.0 }],
  "Editor.Camera.OrbitMmb":     [{ "mouse": "Middle", "trigger": "Drag", "drag_threshold": 0.0 }],
  "Editor.Camera.PanAltShift":  [{ "mouse": "Left",   "mods": ["Alt","Shift"],    "trigger": "Drag", "drag_threshold": 1.0 }],
  "Editor.Camera.PanShiftMmb":  [{ "mouse": "Middle", "mods": ["Shift"],          "trigger": "Drag", "drag_threshold": 0.0 }],
  "Editor.Camera.PanShiftRmb":  [{ "mouse": "Right",  "mods": ["Shift"],          "trigger": "Drag", "drag_threshold": 1.0 }],

  "Game.Example.Jump":          [{ "key": "Space", "trigger": "Pressed" }]
}
