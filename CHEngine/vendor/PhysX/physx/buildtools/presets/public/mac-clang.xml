<?xml version="1.0" encoding="utf-8"?>
<preset name="mac-clang" comment="macOS AppleClang PhysX SDK general settings">
    <platform targetPlatform="mac" compiler="clang" />
    <CMakeSwitches>
        <cmakeSwitch name="PX_BUILDSNIPPETS" value="False" />
        <cmakeSwitch name="PX_BUILDPVDRUNTIME" value="False" />
        <cmakeSwitch name="PX_GENERATE_STATIC_LIBRARIES" value="False" />
        <cmakeSwitch name="PX_GENERATE_GPU_PROJECTS" value="False" />
        <cmakeSwitch name="PX_GENERATE_GPU_PROJECTS_ONLY" value="False" />
        <cmakeSwitch name="PX_SCALAR_MATH" value="False" />
        <cmakeSwitch name="PX_SUPPORT_GPU_PHYSX" value="False" />
        <cmakeSwitch name="NV_USE_STATIC_WINCRT" value="False" />
        <cmakeSwitch name="NV_USE_DEBUG_WINCRT" value="False" />
        <cmakeSwitch name="USE_RESPONSE_FILES" value="False" />
    </CMakeSwitches>
    <CMakeParams>
        <cmakeParam name="CMAKE_INSTALL_PREFIX" value="install/mac-clang/PhysX" />
    </CMakeParams>
</preset>
